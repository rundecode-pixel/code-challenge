# Copy to .env at the repo root. Problem 5 loads it via dotenv.
# Problem 4 needs none of these - it's pure functions.

# --- Problem 5 ---

# Postgres connection string. Matches docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cues

# JWT signing secret. The server refuses to boot if missing or shorter
# than 32 chars. Generate with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-a-strong-random-string-of-at-least-32-chars

# API listen port.
PORT=4000

# "production" silences stack traces in error responses.
NODE_ENV=development
