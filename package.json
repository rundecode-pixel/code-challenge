{
  "name": "code-challenge-solution",
  "version": "1.0.0",
  "private": true,
  "description": "Backend code-challenge solution: problem 4 (sum to n), problem 5 (Pool Cues API), problem 6 (live scoreboard architecture).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:p4": "vitest run src/problem4",
    "test:p5": "vitest run src/problem5",
    "p5:dev": "tsx watch src/problem5/src/server.ts",
    "p5:start": "tsx src/problem5/src/server.ts",
    "p5:db:migrate": "tsx ./node_modules/typeorm/cli.js migration:run -d ./src/problem5/data-source.ts",
    "p5:db:migrate:dev": "tsx ./node_modules/typeorm/cli.js migration:generate src/problem5/migrations/NextMigration -d ./src/problem5/data-source.ts",
    "p5:db:seed": "tsx ./src/problem5/seed.ts",
    "p5:db:reset": "tsx ./src/problem5/reset.ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
